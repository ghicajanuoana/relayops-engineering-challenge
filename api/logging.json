{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "safe": {"()": "app.observability.SafeFormatter", "fmt": "%(asctime)s %(levelname)s %(message)s"}
  },
  "handlers": {
    "default": {"class": "logging.StreamHandler", "formatter": "safe", "stream": "ext://sys.stderr"}
  },
  "loggers": {
    "uvicorn": {"handlers": ["default"], "level": "INFO", "propagate": false},
    "uvicorn.error": {"level": "INFO", "propagate": true},
    "uvicorn.access": {"handlers": [], "level": "INFO", "propagate": false}
  }
}
