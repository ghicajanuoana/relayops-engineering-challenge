# Optional overrides. Compose generates persistent random credentials if omitted.
# Never commit real secrets. Blank values use the generated credentials.
POSTGRES_USER=relayops
POSTGRES_PASSWORD=
POSTGRES_DB=relayops

WEBHOOK_SECRET=
RECEIVER_URL=http://receiver:9000/webhook
POLL_INTERVAL=1
BATCH_SIZE=10
GATEWAY_PORT=8080
RECEIVER_PORT=9000
